{
    "name": "fajarsulaksono/chumptable",
    "description": "This is a Laravel package for the server and client side of datatables at http://datatables.net/",
    "keywords": [
        "laravel",
        "datatables",
        "ajax",
        "jquery"
    ],
    "license": "MIT",
    "homepage": "https://github.com/fajarsulaksono/chumptable",
    "authors": [
        {
            "name": "Fajar Sulaksono",
            "email": "fajar.sulaksono@gmail.com",
            "homepage": "https://github.com/fajarsulaksono",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/config": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "Chumptable\\Datatable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chumptable\\Datatable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chumptable\\Datatable\\DatatableServiceProvider"
            ],
            "aliases": {
                "Datatable": "Chumptable\\Datatable\\Facades\\DatatableFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
